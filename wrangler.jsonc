{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "media-tracker",
  "compatibility_date": "2026-10-26",
  "main": "./worker/index.ts",
  "upload_source_maps": true,
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "observability": {
    "enabled": true
  }

  // D1 is intentionally NOT configured here. Bind the existing D1 database
  // in the Cloudflare dashboard with the binding name MEDIA_TRACKER_DB.
  //
  // The public custom domain remains deployment configuration: vite.config.ts
  // injects it from PUBLIC_HOST when set. The generated Worker configuration
  // in dist/media_tracker/wrangler.json is what Wrangler uses for deploy.
}

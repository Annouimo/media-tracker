{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "media-tracker",
  "compatibility_date": "2026-10-26",
  "main": "./worker/index.ts",
  "upload_source_maps": true,
  "workers_dev": false,
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "observability": {
    "enabled": true
  }

  // D1 and custom domains are managed in the Cloudflare dashboard.
  //
  // Bind the existing D1 database with the binding name MEDIA_TRACKER_DB.
  // Attach one or more custom domains under Domains & Routes.
  //
  // `workers_dev` is false and there are no `routes` keys here so that
  // `wrangler deploy` does not override dashboard-managed domains.
}

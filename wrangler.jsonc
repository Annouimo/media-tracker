{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "media-tracker",
  "compatibility_date": "2026-10-26",
  "main": "./worker/index.ts",
  "upload_source_maps": true,
  "workers_dev": false,
  "vars": {
    "ACCESS_TEAM_DOMAIN": "https://annouimo.cloudflareaccess.com",
    "ACCESS_AUD": "25eda77e3454c4add9aac197b4824abd2cdd30ef04ce022aa0506287d2a417a5"
  },
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/admin/api/*"]
  },
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "MEDIA_TRACKER_DB",
      "database_name": "media-tracker-db",
      "database_id": "7d60ec75-c0e4-44f4-89e2-b8addfd7d9ac"
    }
  ],
  "previews": {
    "vars": {
      "ACCESS_TEAM_DOMAIN": "https://annouimo.cloudflareaccess.com",
      "ACCESS_AUD": "25eda77e3454c4add9aac197b4824abd2cdd30ef04ce022aa0506287d2a417a5"
    },
    "d1_databases": [
      {
        "binding": "MEDIA_TRACKER_DB",
        "database_name": "media-tracker-db",
        "database_id": "7d60ec75-c0e4-44f4-89e2-b8addfd7d9ac"
      }
    ]
  }

  // D1 is declared here because Wrangler treats this file as the source of
  // truth; a dashboard-only binding is removed on the next `wrangler deploy`.
  // The database_id is an identifier, not a secret.
  //
  // Custom domains are intentionally NOT declared here. `workers_dev` is false
  // and there are no `routes` keys, so domains remain managed in the
  // Cloudflare dashboard (Domains & Routes) and can be added/removed freely.
  //
  // Previews do not inherit production settings; the `previews` block above
  // gives the branch preview its D1 binding. It currently points at the same
  // database; create a separate preview D1 before write features touch data.
  //
  // Cloudflare Access is configured in `vars` above and in `previews.vars`.
  // The same Access policy/AUD covers production and preview in this project.
  // Localhost can use DEV_AUTH_BYPASS=1 in .dev.vars; it is ignored for
  // non-local hosts. Missing Access config fails closed with
  // access_not_configured.
}

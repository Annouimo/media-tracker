{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "media-tracker",
  "compatibility_date": "2026-10-26",
  "main": "./worker/index.ts",
  "upload_source_maps": true,
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "observability": {
    "enabled": true
  }

  // D1 binding and the production custom domain are intentionally NOT
  // hardcoded here. They are injected by vite.config.ts from:
  //
  //   D1_DATABASE_ID
  //   D1_DATABASE_NAME
  //   PUBLIC_HOST
  //
  // Local development reads .env.local. Workers Builds reads the build
  // variables configured in the Cloudflare dashboard. The generated Worker
  // configuration in dist/media_tracker/wrangler.json is what Wrangler uses
  // for preview/deploy.
}

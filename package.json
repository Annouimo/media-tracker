{
  "name": "media-tracker",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "bun@1.4.3",
  "scripts": {
    "dev": "vite",
    "dev:node": "node node_modules/vite/bin/vite.js",
    "build": "bun run typecheck && vite build",
    "preview": "bun run build && vite preview",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.worker.json",
    "deploy": "bun run build && wrangler deploy",
    "deploy:ci": "wrangler deploy"
  },
  "dependencies": {
    "hono": "^4.13.14",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.65.0",
    "@cloudflare/workers-types": "^5.20261027.1",
    "@vitejs/plugin-vue": "^6.0.10",
    "typescript": "5",
    "vite": "^8.3.5",
    "vue-tsc": "^3.3.13",
    "wrangler": "^4.153.0"
  }
}

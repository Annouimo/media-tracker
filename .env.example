# Build-time configuration (not Worker runtime vars).
#
# Local development: copy to .env.local and fill in.
# Workers Builds: add these under Settings -> Build -> Build variables and secrets.
D1_DATABASE_ID=
D1_DATABASE_NAME=

# Production custom domain, for example media-tracker.annouimo.com.
# Required in Workers Builds; omit for a local build if you do not want a route.
PUBLIC_HOST=

# Only needed for remote D1 CLI commands, not for the build.
# Put the API token in the shell environment, not in this file.
# CLOUDFLARE_ACCOUNT_ID=
